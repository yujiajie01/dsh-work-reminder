{
  "name": "@local/work-reminder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Work-time reminders for the DSH web UI: multiple daily times, a full-screen animated overlay that pulls the DSH window to the front, with dismiss and 5-minute snooze.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
